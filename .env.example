# Example environment variables for local development

# Database (SQLite default if not provided)
DATABASE_URL=sqlite:///./test.db

# Redis (optional, not required for local startup)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=super-secret-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model configuration
MODEL_PATH=./ml_models/trained_models/
CONFIDENCE_THRESHOLD=0.85
RETRAINING_INTERVAL=7

# Debugging / logging
DEBUG=True
LOG_LEVEL=INFO
